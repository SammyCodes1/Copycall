# Copycall environment template. Copy to .env.local and fill in values.
# NEVER commit real values. Everything is server-only unless it starts with NEXT_PUBLIC_.

# --- Panta API (server only) ---
# Sent only as the X-Api-Key header from lib/panta.ts. Never in a URL, never in the browser.
PANTA_API_KEY=
# Must be https://live-api.panta.market/api/v1 (lib/panta.ts refuses any other host).
PANTA_BASE_URL=https://live-api.panta.market/api/v1
# Comma-separated allowlist of Panta program IDs used by transaction validation (batch 2).
PANTA_PROGRAM_IDS=
# Panta fee model, pinned per deployment: inclusive (fee comes out of the deposit) or
# on_top (fee is charged on top). REQUIRED in real mode; copy fails closed (503) without it.
# Find it with one quote-only call: node scripts/panta-fee-model.mjs --market <id> --side yes
# A quote that contradicts this value is refused (never re-interpreted).
PANTA_FEE_MODEL=
# Fee sanity cap as bps of the stake (default 500 = 5%, max 1000). Higher fees are refused.
PANTA_FEE_CAP_BPS=

# --- Solana (server only) ---
# Dedicated mainnet RPC (e.g. Helius). Contains an API key, so it is never exposed to the browser.
SOLANA_RPC_URL=

# --- Supabase ---
SUPABASE_URL=
# Service-role key: server only (lib/db.ts). Bypasses RLS. Never expose.
SUPABASE_SERVICE_ROLE_KEY=
# Public values. Listed for completeness; per the security addendum the browser never queries
# Supabase directly, so the app does not currently read these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Telegram (server only, batch 2) ---
# Both are needed; without them alerts are logged instead of sent.
# Secret: 32+ chars of A-Z a-z 0-9 _ -. Register with: node --env-file=.env.local scripts/telegram-set-webhook.mjs
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- App secrets (server only) ---
# Cron routes require "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
# At least 32 random characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# --- App config ---
# Minimum resolved positions before a wallet can appear on the leaderboard.
MIN_RESOLVED_CALLS=5
# true = use /fixtures and simulated signing. The app refuses to boot if this is true on Vercel production.
MOCK_PANTA=true
# Mock only: which Panta fee model the fixtures play (inclusive | on_top). Default inclusive.
MOCK_PANTA_FEE_MODEL=
# Exact origin of the app, no trailing slash. Used for the SIWS domain and the Origin (CSRF) check.
APP_URL=http://localhost:3000
